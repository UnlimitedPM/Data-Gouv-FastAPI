# Copier vers backend/.env puis adapter si besoin.

# API data.gouv.fr
DFE_DATAGOUV_API_BASE=https://www.data.gouv.fr/api
DFE_HTTP_TIMEOUT=20

# Cache memoire
DFE_CACHE_TTL=300
DFE_CACHE_MAXSIZE=512
# Optionnel : cache Redis partage (laisser vide pour rester en memoire)
# DFE_REDIS_URL=redis://127.0.0.1:6379/0

# Limites de previsualisation
DFE_MAX_DOWNLOAD_MB=25
DFE_MAX_PARQUET_DOWNLOAD_MB=60
DFE_MAX_GEOJSON_DOWNLOAD_MB=100
DFE_PROFILE_ROWS=20000

# CORS ("*" ou liste separee par des virgules)
DFE_CORS_ORIGINS=*
